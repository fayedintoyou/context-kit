flowchart TD
  n_posted(("A teammate posts"))
  n_what_kind{"What kind of post is it?"}
  n_dot("A quiet dot appears next to the room")
  n_badge("The room shows a number badge")
  n_seen(["You've seen it"])
  n_posted --> n_what_kind
  n_what_kind -->|"A post in a room, no @mention"| n_dot
  n_what_kind -->|"A DM or an @mention"| n_badge
  n_dot --> n_seen
  n_badge --> n_seen
  classDef st_untested fill:#ffffff,stroke:#6b7280,stroke-dasharray:5 4,color:#111827
  class n_dot,n_badge st_untested
  subgraph status_key["Key"]
    direction LR
    key_untested("No tests yet (derived)"):::st_untested
  end
